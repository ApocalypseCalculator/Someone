generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model Channel {
    channelid String  @id
    guild     String
    blocked   Boolean @default(false)
    webhook   String?
}

model Guild {
    guildid              String               @id
    ignorebots           Boolean              @default(true)
    lastmemberfetch      DateTime             @default(now())
    djs_members_uncached Boolean              @default(false)
    memberscache         MemberByGuildCache[]
}

model MemberByGuildCache {
    guild     Guild  @relation(fields: [guildid], references: [guildid])
    guildid   String
    discordid String

    // note: we do not create a relation to User to prevent unnecessary indexing & IO performance hits
    @@id([guildid, discordid]) // only 1 per guild per user
}

model User {
    discordid String   @id
    lastping  DateTime @default(now())
    pinged    Int
}

model Error {
    errid     String   @id
    error     String
    time      DateTime @default(now())
    guild     String
    channelid String
    discordid String
    command   String
}
