generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:data.db"
}

model Channel {
    channelid        String            @id
    guild            String
    blocked          Boolean           @default(false)
    webhook          String?
    memberByChannels MemberByChannel[]
}

model Guild {
    guildid         String  @id
    ignorebots      Boolean @default(true)
    lastmemberfetch Int     @default(0)
}

model MemberByChannel {
    channel   Channel @relation(fields: [channelid], references: [channelid])
    channelid String
    discordid String

    // note: we do not create a relation to User to prevent unnecessary indexing & IO performance hits
    @@id([channelid, discordid]) // only 1 per channel per user
}

model User {
    discordid String @id
    lastping  Int
    pinged    Int
}

model Error {
    errid     String @id
    error     String
    time      Int
    guild     String
    channelid String
    discordid String
    command   String
}
