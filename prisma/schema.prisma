generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model Channel {
    channelid        String            @id
    guild            String
    blocked          Boolean           @default(false)
    webhook          String?
    memberByChannels MemberByChannel[]
}

model Guild {
    guildid         String   @id
    ignorebots      Boolean  @default(true)
    lastmemberfetch DateTime @default(now())
}

model MemberByChannel {
    channel   Channel @relation(fields: [channelid], references: [channelid])
    channelid String
    discordid String

    // note: we do not create a relation to User to prevent unnecessary indexing & IO performance hits
    @@id([channelid, discordid]) // only 1 per channel per user
}

model User {
    discordid String   @id
    lastping  DateTime @default(now())
    pinged    Int
}

model Error {
    errid     String   @id
    error     String
    time      DateTime @default(now())
    guild     String
    channelid String
    discordid String
    command   String
}
